### API configuration ###
API_URL=http://localhost:8080
UI_URL=http://localhost:3000

# Optional: override JVM runtime flags for the API container/runtime.
#API_JAVA_OPTS=-javaagent:/app/otel-agent.jar

# Discord application secrets - make sure these are never committed!
DISCORD_GUILD_ID=GUILD_ID
DISCORD_CLIENT_ID=CLIENT_ID
DISCORD_CLIENT_SECRET=CLIENT_SECRET
DISCORD_BOT_TOKEN=BOT_TOKEN

# Base64-encoded 32-byte key used to encrypt auth records at rest.
AUTH_ENCRYPTION_KEY_BASE64=REPLACE_WITH_A_BASE64_32_BYTE_KEY

ADMIN_DISCORD_IDS=1,2,3

### UI configuration ###
# For security reasons, Vite won't include environment variables in the front-end build unless it's prefixed with VITE_
VITE_API_URL=http://localhost:8080

# Jam branding/content is configured per-jam in the database and admin dashboard.

# The start/end dates need to be a format that `new Date("...")` will parse correctly in JS
#VITE_JAM_START="2022-04-09 10:00:00"
#VITE_JAM_END="2022-12-01 10:00:00"

# VITE_SENTRY_DSN = ... # UI monitoring, disabled by default

### Database configuration ###
# Connecting to local database from Docker
DATABASE_URL=mongodb://root:example@db/admin

# Connecting to local database from local
#DATABASE_URL=mongodb://root:example@localhost/admin

# Connecting to remote DB from local
# (You'll need to fill in your own creds)
#DATABASE_URL=mongodb+srv://$user:$password@$host/?retryWrites=true&w=majority
